;; Logical positions evidenced by the frozen Manna Cadet layered variants.
;; Coordinates are retained only where the prior fixture supplied them; the
;; migration has not inferred geometry from XKB key names or Kanata token order.
;; Number row.
;; Alphanumeric/static-symbol positions.
;; <LSGT> has a static XKB table but no direct layered-Kanata source token.
;; Both primary normal layers preserve these two defsrc tokens unchanged.
;; They are immediate physical case holders; no home-row Shift tap-hold is
;; implied by these distinct positions.
;; The immediate Greek selector is evidenced on both primary layered
;; variants.  Its carrier lowering is not embedded in the layout.
;; The immediate Top selector is likewise direct in both primary variants.
;; Enter's separate tap-hold Top path is intentionally not inferred here.
;; This is one physical location with device-specific inactive output:
;; Menu on Advantage 2 and Caps Lock on Advantage 360.  The primary function
;; patch gives both variants the same active Alt Mode command.

(ivory-key 1)
(define-topology
  kinesis-advantage
  (position number-equals)
  (position number-1)
  (position number-2)
  (position number-3)
  (position number-4)
  (position number-5)
  (position number-6)
  (position number-7)
  (position number-8)
  (position number-9)
  (position number-0)
  (position number-minus)
  (position tab)
  (position q (:row 1) (:column 1) (:hand left) (:finger pinky))
  (position w)
  (position e)
  (position r)
  (position t (:row 1) (:column 5) (:hand left) (:finger index))
  (position y)
  (position u)
  (position i (:row 1) (:column 8) (:hand right) (:finger middle))
  (position o (:row 1) (:column 9) (:hand right) (:finger ring))
  (position p)
  (position left-bracket)
  (position right-bracket)
  (position return)
  (position a)
  (position s)
  (position d)
  (position f)
  (position g)
  (position h)
  (position j)
  (position k)
  (position l)
  (position semicolon)
  (position apostrophe)
  (position grave)
  (position backslash)
  (position z)
  (position x)
  (position c)
  (position v)
  (position b)
  (position n)
  (position m)
  (position comma)
  (position period)
  (position slash)
  (position backspace)
  (position space)
  (position less-greater)
  (position case-left-shift)
  (position case-right-shift)
  (position greek (:row 6) (:column 1) (:hand left) (:finger thumb))
  (position top (:row 6) (:column 4) (:hand right) (:finger thumb))
  (position mode-key)
)

;; Physical source placements mechanically transcribed from the frozen layered
;; Manna Cadet Advantage 360 Kanata defsrc.  Quoted
;; spellings preserve source tokens such as numbers and punctuation exactly.
;; <LSGT> has no direct defsrc token, so its device placement is not guessed.

(ivory-key 1)
(define-device
  kinesis-advantage360
  (uses-topology kinesis-advantage)
  (place number-equals (:xkb "AE12") (:kanata "="))
  (place number-1 (:xkb "AE01") (:kanata "1"))
  (place number-2 (:xkb "AE02") (:kanata "2"))
  (place number-3 (:xkb "AE03") (:kanata "3"))
  (place number-4 (:xkb "AE04") (:kanata "4"))
  (place number-5 (:xkb "AE05") (:kanata "5"))
  (place number-6 (:xkb "AE06") (:kanata "6"))
  (place number-7 (:xkb "AE07") (:kanata "7"))
  (place number-8 (:xkb "AE08") (:kanata "8"))
  (place number-9 (:xkb "AE09") (:kanata "9"))
  (place number-0 (:xkb "AE10") (:kanata "0"))
  (place number-minus (:xkb "AE11") (:kanata "-"))
  (place tab (:xkb "TAB") (:kanata "tab"))
  (place q (:xkb "AD01") (:kanata "q"))
  (place w (:xkb "AD02") (:kanata "w"))
  (place e (:xkb "AD03") (:kanata "e"))
  (place r (:xkb "AD04") (:kanata "r"))
  (place t (:xkb "AD05") (:kanata "t"))
  (place y (:xkb "AD06") (:kanata "y"))
  (place u (:xkb "AD07") (:kanata "u"))
  (place i (:xkb "AD08") (:kanata "i"))
  (place o (:xkb "AD09") (:kanata "o"))
  (place p (:xkb "AD10") (:kanata "p"))
  (place left-bracket (:xkb "AD11") (:kanata "["))
  (place right-bracket (:xkb "AD12") (:kanata "]"))
  (place return (:xkb "RTRN") (:kanata "ent"))
  (place a (:xkb "AC01") (:kanata "a"))
  (place s (:xkb "AC02") (:kanata "s"))
  (place d (:xkb "AC03") (:kanata "d"))
  (place f (:xkb "AC04") (:kanata "f"))
  (place g (:xkb "AC05") (:kanata "g"))
  (place h (:xkb "AC06") (:kanata "h"))
  (place j (:xkb "AC07") (:kanata "j"))
  (place k (:xkb "AC08") (:kanata "k"))
  (place l (:xkb "AC09") (:kanata "l"))
  (place semicolon (:xkb "AC10") (:kanata ";"))
  (place apostrophe (:xkb "AC11") (:kanata "'"))
  (place grave (:xkb "TLDE") (:kanata "grv"))
  (place backslash (:xkb "BKSL") (:kanata "\\"))
  (place z (:xkb "AB01") (:kanata "z"))
  (place x (:xkb "AB02") (:kanata "x"))
  (place c (:xkb "AB03") (:kanata "c"))
  (place v (:xkb "AB04") (:kanata "v"))
  (place b (:xkb "AB05") (:kanata "b"))
  (place n (:xkb "AB06") (:kanata "n"))
  (place m (:xkb "AB07") (:kanata "m"))
  (place comma (:xkb "AB08") (:kanata ","))
  (place period (:xkb "AB09") (:kanata "."))
  (place slash (:xkb "AB10") (:kanata "/"))
  (place backspace (:xkb "BKSP") (:kanata "bspc"))
  (place space (:xkb "SPCE") (:kanata "spc"))
  ;; Both direct Shift source tokens remain unchanged in the frozen normal
  ;; layer.  XKB maps their physical keys to the two standard Shift keysyms.
  (place case-left-shift (:xkb "LFSH") (:kanata "lshift"))
  (place case-right-shift (:xkb "RTSH") (:kanata "rshift"))
  ;; The Advantage 360 layered source calls this position lctl; normal-layer @gr emits the Greek selector carrier.
  (place greek (:xkb "ZEHA") (:kanata "lctl"))
  ;; The direct rctl source emits the Top selector carrier.  Enter's distinct
  ;; tap-hold alias is not represented by this immediate placement.
  (place top (:xkb "LVL3") (:kanata "rctl"))
  ;; This shared logical position has a device-specific inactive result: Caps
  ;; Lock here, Menu on Advantage 2.  The function patch result is common.
  (place mode-key (:xkb "CAPS") (:kanata "caps"))
  ;; Seen arbitrary-code values, retained as unavailable physical carriers.
  (reserve-carriers 84 85 183 184 185 186 187 188 189 190 191 192 193 194
                    195 196 197 198 199 211 212 218 219 220 221 222 223 224
                    225 226 240)
)

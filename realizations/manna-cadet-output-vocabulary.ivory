  ;; Primary `fun` layer: the XKB keysym and Kanata action are paired frozen
  ;; evidence.  The profile validator still owns safety checking of both.
  (map-output named-symbol roman-one (:xkb "U2160") (:kanata "(arbitrary-code 218)"))
  (map-output named-symbol roman-two (:xkb "U2161") (:kanata "(arbitrary-code 219)"))

;; The frozen primary layered source has a separate Advantage 360 placement.
;; This composition selects that placement only; it does not claim that the
;; Advantage 360-only game layer or any unresolved carrier/timing behavior is
;; compiled or deployed.
;; This is the closed generated-XKB selector sub-contract.  The declarations
;; below transcribe the hash-pinned Group1 type choice for every static
;; table and the common Group2 TWO_LEVEL table. The buffered clauses below
;; select the versioned reference lifetime and closed allocations, but not an
;; exact native input-domain, frozen client equivalence, or deployable artifact.
;; Accepted, revisitable compatibility choice for the frozen primary
;; Kanata 1.12 source.  The closed allocation table records only observed
;; atoms/codes; the compiler still refuses artifact publication until the
;; full native input-domain differential is complete.
;; Frozen Advantage 360 source-only aliases.  They are harmlessly unused
;; by the Advantage2 composition and keep their distinct F18-F21 outputs.

(ivory-key 1)
(define-realization
  manna-cadet-linux-xkb-kanata
  (pipeline kanata xkb)
  (uses-output-vocabulary manna-cadet-linux-output)
  (allow-grades exact emulated)
  (forbid-shell-actions yes)
  (validation (kanata-check required) (xkbcli-compile-keymap required))
  (interaction-compatibility
    kanata-1-12-buffered
    (instances tap-hold-alt-backspace tap-hold-alt-space tap-hold-case-f tap-hold-case-j tap-hold-control-d tap-hold-control-k tap-hold-function-end tap-hold-function-pgdn tap-hold-hyper-apostrophe tap-hold-hyper-escape tap-hold-meta-l tap-hold-meta-s tap-hold-plane-enter tap-hold-script-delete tap-hold-super-a tap-hold-super-semicolon)
  )
  (kanata-buffered-allocations
    (close-unmapped-input yes)
    (local-key K18 127 f18)
    (local-key K19 130 f19)
    (local-key K20 115 f20)
    (local-key K21 142 f21)
    (pass-through case-left-shift case-right-shift control-plane-alt direct-hyper mode-key)
    (route down down)
    (route home home)
    (route left left)
    (route page-up pgup)
    (route right right)
    (route up up)
    (action
      tap-hold-alt-backspace
      (alias hro)
      (tap bspc)
      (hold modifier alt ralt)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-alt-space
      (alias hsp)
      (tap spc)
      (hold modifier alt ralt)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-case-f
      (alias sf)
      (tap f)
      (hold axis-modifier case shifted lshift)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-case-j
      (alias sj)
      (tap j)
      (hold axis-modifier case shifted lshift)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-control-d
      (alias cd)
      (tap d)
      (hold modifier control lctl)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-control-k
      (alias ck)
      (tap k)
      (hold modifier control lctl)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-function-end
      (alias hscl)
      (tap end)
      (hold axis-layer function active fun fun)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-function-pgdn
      (alias hscr)
      (tap pgdn)
      (hold axis-layer function active fun fun)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-hyper-apostrophe
      (alias qoam)
      (tap "'")
      (hold modifier hyper rmet)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-hyper-escape
      (alias eoam)
      (tap esc)
      (hold modifier hyper rmet)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-meta-l
      (alias ml)
      (tap l)
      (hold modifier meta lalt)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-meta-s
      (alias ms)
      (tap s)
      (hold modifier meta lalt)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-plane-enter
      (alias rtop)
      (tap ent)
      (hold axis-carrier plane top 84)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-script-delete
      (alias gdel)
      (tap del)
      (hold axis-carrier script greek 85)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-super-a
      (alias sa)
      (tap a)
      (hold modifier super lmet)
      (routes down home left page-up right up)
    )
    (action
      tap-hold-super-semicolon
      (alias ssemi)
      (tap ";")
      (hold modifier super lmet)
      (routes down home left page-up right up)
    )
  )
  (selector-policy
    (static-type number-equals four-level two-level)
    (static-type number-1 four-level two-level)
    (static-type number-2 four-level two-level)
    (static-type number-3 four-level two-level)
    (static-type number-4 four-level two-level)
    (static-type number-5 four-level two-level)
    (static-type number-6 four-level two-level)
    (static-type number-7 four-level two-level)
    (static-type number-8 four-level two-level)
    (static-type number-9 four-level two-level)
    (static-type number-0 four-level two-level)
    (static-type number-minus four-level two-level)
    (static-type tab four-level two-level)
    (static-type q four-level-alphabetic two-level)
    (static-type w four-level-alphabetic two-level)
    (static-type e four-level-alphabetic two-level)
    (static-type r four-level-alphabetic two-level)
    (static-type t four-level-alphabetic two-level)
    (static-type y four-level-alphabetic two-level)
    (static-type u four-level-alphabetic two-level)
    (static-type i four-level-alphabetic two-level)
    (static-type o four-level-alphabetic two-level)
    (static-type p four-level-alphabetic two-level)
    (static-type left-bracket four-level two-level)
    (static-type right-bracket four-level two-level)
    (static-type return four-level two-level)
    (static-type a four-level-alphabetic two-level)
    (static-type s four-level-alphabetic two-level)
    (static-type d four-level-alphabetic two-level)
    (static-type f four-level-alphabetic two-level)
    (static-type g four-level-alphabetic two-level)
    (static-type h four-level-alphabetic two-level)
    (static-type j four-level-alphabetic two-level)
    (static-type k four-level-alphabetic two-level)
    (static-type l four-level-alphabetic two-level)
    (static-type semicolon four-level two-level)
    (static-type apostrophe four-level two-level)
    (static-type grave four-level two-level)
    (static-type backslash four-level two-level)
    (static-type z four-level-alphabetic two-level)
    (static-type x four-level-alphabetic two-level)
    (static-type c four-level-alphabetic two-level)
    (static-type v four-level-alphabetic two-level)
    (static-type b four-level-alphabetic two-level)
    (static-type n four-level-alphabetic two-level)
    (static-type m four-level-alphabetic two-level)
    (static-type comma four-level two-level)
    (static-type period four-level two-level)
    (static-type slash four-level two-level)
    (static-type backspace four-level two-level)
    (static-type space four-level two-level)
    (static-type less-greater four-level two-level)
    (selector case shifted shift consumed core-shift)
    (selector script greek level-three consumed consumed-level-three)
    (selector plane top group-two group-action libxkbcommon-depressed-group-two-with-visible-level-three)
    (carrier greek script greek 85 zeha)
    (carrier top plane top 84 lvl3)
  )
)
(realize
  manna-cadet-linux
  (:layout manna-cadet)
  (:device kinesis-advantage2)
  (:profile manna-cadet-linux-xkb-kanata)
)
(realize
  manna-cadet-advantage360-linux
  (:layout manna-cadet)
  (:device kinesis-advantage360)
  (:profile manna-cadet-linux-xkb-kanata)
)

+#[test]
+fn ivory_key_manna_release_oracle() {
+    let cfg = "
+      (defcfg concurrent-tap-hold yes process-unmapped-keys yes)
+      (defsrc a s d b)
+      (deflayer base @a @s @d b)
+      (defalias
+        a (tap-hold-release 200 200 x lctl)
+        s (tap-hold-release 200 200 y lctl)
+        d (tap-hold-release 250 250 z lalt))
+    ";
+    for (events, expected) in [
+        ("d:a t:199 u:a t:10", "t:199ms dn:X t:6ms up:X"),
+        ("d:a t:200 u:a t:10", "t:199ms dn:LCtrl t:1ms up:LCtrl"),
+        ("d:d t:249 u:d t:10", "t:249ms dn:Z t:6ms up:Z"),
+        ("d:d t:250 u:d t:10", "t:249ms dn:LAlt t:1ms up:LAlt"),
+        ("d:a t:50 d:b t:50 u:b t:50 u:a t:10",
+         "t:100ms dn:LCtrl t:6ms dn:B t:1ms up:B t:43ms up:LCtrl"),
+        ("d:a t:50 d:b t:10 u:a t:10 u:b t:10",
+         "t:60ms dn:X t:6ms dn:B t:1ms up:X t:3ms up:B"),
+        ("d:a t:10 d:s t:200 u:a t:20 u:s t:10",
+         "t:199ms dn:LCtrl t:31ms up:LCtrl"),
+        ("d:a t:10 d:s t:200 u:s t:20 u:a t:10",
+         "t:199ms dn:LCtrl t:31ms up:LCtrl"),
+    ] {
+        assert_eq!(expected, simulate(cfg, events).to_ascii());
+    }
+}

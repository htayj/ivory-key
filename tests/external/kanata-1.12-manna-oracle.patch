+#[test]
+fn ivory_key_actual_advantage2_oracle() {
+    let cfg = include_str!("../../../cfg_samples/ivory-key-manna.kbd");
+    for (events, expected) in [
+        ("d:f t:199 u:f t:10", "t:199ms dn:F t:6ms up:F"),
+        ("d:f t:200 u:f t:10", "t:199ms dn:LShift t:1ms up:LShift"),
+        ("d:f t:50 d:b t:50 u:b t:50 u:f t:10",
+         "t:100ms dn:LShift t:6ms dn:B t:1ms up:B t:43ms up:LShift"),
+        ("d:f t:50 d:b t:10 u:f t:10 u:b t:10",
+         "t:60ms dn:F t:6ms dn:B t:1ms up:F t:3ms up:B"),
+        ("d:f t:10 d:j t:200 u:f t:20 u:j t:10",
+         "t:199ms dn:LShift t:31ms up:LShift"),
+        ("d:end t:10 d:pgdn t:200 d:q t:10 u:q t:10 u:end t:10 d:q t:10 u:q t:10 u:pgdn t:10 d:q t:10 u:q t:10",
+         "t:210ms out-code:185;Press t:10ms out-code:185;Release t:20ms out-code:185;Press t:10ms out-code:185;Release t:20ms dn:Q t:10ms up:Q"),
+    ] {
+        assert_eq!(expected, simulate(cfg, events).to_ascii());
+    }
+}

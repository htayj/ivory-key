+#[test]
+fn ivory_key_manna_function_owner_oracle() {
+    let cfg = "
+      (defcfg concurrent-tap-hold yes process-unmapped-keys yes)
+      (defsrc a s b)
+      (deflayer base @a @s b)
+      (deflayer fun @a @s c)
+      (defalias
+        a (tap-hold-release 200 200 x (layer-while-held fun))
+        s (tap-hold-release 200 200 y (layer-while-held fun)))
+    ";
+    for events in [
+        "d:a t:10 d:s t:200 d:b t:10 u:b t:10 u:a t:10 d:b t:10 u:b t:10 u:s t:10 d:b t:10 u:b t:10",
+        "d:a t:10 d:s t:200 d:b t:10 u:b t:10 u:s t:10 d:b t:10 u:b t:10 u:a t:10 d:b t:10 u:b t:10",
+    ] {
+        assert_eq!(
+            "t:210ms dn:C t:10ms up:C t:20ms dn:C t:10ms up:C t:20ms dn:B t:10ms up:B",
+            simulate(cfg, events).to_ascii()
+        );
+    }
+}

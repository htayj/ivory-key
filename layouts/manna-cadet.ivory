  ;; The frozen primary layered files contain this entire function table.  It
  ;; is a semantic patch, not a Kanata layer spelling.  The two 200 ms
  ;; tap-hold activators (End and PgDn) and their cancellation policy are not
  ;; represented here: no activation behavior is guessed from Kanata.
  (overlay primary-function
    (:axis function)
    (:state active)
    (:precedence 100)
    ;; These function results have frozen alias identities and exact carrier
    ;; pairs.  They are named symbols rather than direct Unicode here so the
    ;; realization—not the layout—owns the carrier/XKB spelling.
    (binding number-1 (named-symbol roman-one))
    (binding number-2 (named-symbol roman-two))
    (binding number-3 (named-symbol roman-three))
    (binding number-4 (named-symbol roman-four))
    (binding number-7 (named-symbol finger-left))
    (binding number-8 (named-symbol thumb-up))
    (binding number-9 (named-symbol thumb-down))
    (binding number-0 (named-symbol finger-right))
    (binding q (command quote))
    (binding w (command terminal))
    (binding e (command macro))
    (binding t (command over-strike))
    (binding u (command status))
    (binding i (command call))
    (binding o (command stop-output))
    (binding s (command system))
    (binding g (command abort))
    (binding h (command help))
    (binding j (command line))
    (binding k (command clear-input))
    (binding l (command clear-screen))
    (binding semicolon (command end))
    (binding z (command hold-output))
    (binding x (command network))
    (binding c (command break))
    (binding m (command resume))
    (binding period (command repeat))
    (binding grave (command mode-lock))
    ;; The shared logical mode-key denotes the same physical location in both
    ;; devices.  Its inactive result differs (Menu on Advantage 2, Caps Lock
    ;; on Advantage 360), so only its common active function result is stated.
    (binding mode-key (command alt-mode))
  )
)

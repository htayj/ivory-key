    (at (plain roman base) (named-symbol period))
    (at (shifted roman base) (named-symbol greater))
    (at (plain greek base) (named-symbol guillemetright))
    (at (shifted greek base) (unicode "》"))
    (at (plain roman top) none)
    (at (shifted roman top) none)
    (at (plain greek top) none)
    (at (shifted greek top) none)
  )
  (binding
    slash
    (at (plain roman base) (named-symbol slash))
    (at (shifted roman base) (named-symbol question))
    (at (plain greek base) (named-symbol integral))
    (at (shifted greek base) none)
    (at (plain roman top) none)
    (at (shifted roman top) none)
    (at (plain greek top) none)
    (at (shifted greek top) none)
  )

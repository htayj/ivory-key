;; Mechanically transcribed static XKB symbol evidence for the frozen Manna
;; Cadet baseline.  See docs/manna-cadet-baseline.md and
;; tools/manna-truth-table.lisp for the frozen hashes and raw keysyms.
;;
;; The eight table cells use the documented case/script/plane order.  The
;; static Top XKB group is TWO_LEVEL: its Greek+Top cells therefore repeat its
;; observed Top symbol.  This records symbol selection only.  The primary
;; layered function table below is also transcribed. Its realization allocates
;; the frozen carriers; activation, selector policy, and tap-hold timing remain
;; explicitly unresolved.

(ivory-key 1)
(define-layout
  manna-cadet
  (uses-topology kinesis-advantage)
  (axis case (:states plain shifted) (:resolution product))
  (axis script (:states roman greek) (:resolution product))
  (axis plane (:states base top) (:resolution product))
  (axis function (:states inactive active) (:resolution patch))
  (level-order case script plane)
  (modifiers control meta super hyper alt)

  ;; Static XKB tables.  NAMED-SYMBOL is a semantic registry name, not an XKB
  ;; keysym escape hatch; the raw source spelling remains in the frozen truth
  ;; table.  Unicode scalars and named keys are recorded directly.
  (binding number-1
    (at (plain roman base) (unicode "1"))
    (at (shifted roman base) (named-symbol exclam))
    (at (plain greek base) (named-symbol dagger))
    (at (shifted greek base) none)
    (at (plain roman top) none)
    (at (shifted roman top) none)
    (at (plain greek top) none)
    (at (shifted greek top) none)
  )
  (binding number-2
    (at (plain roman base) (unicode "2"))
    (at (shifted roman base) (named-symbol at))
    (at (plain greek base) (named-symbol doubledagger))
    (at (shifted greek base) none)
    (at (plain roman top) none)
    (at (shifted roman top) none)
    (at (plain greek top) none)
    (at (shifted greek top) none)
  )
  (binding number-3
    (at (plain roman base) (unicode "3"))

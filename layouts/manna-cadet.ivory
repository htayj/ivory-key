    (:participants greek)
    (case
      held
      (:match (down greek))
      (:commit when-matched)
      (:do none)
      (:while (hold-axis-state script greek))
      (:exit (set-axis-state script roman))
    )
  )
  (interaction
    hold-top-selector
    (:participants top)
    (case
      held
      (:match (down top))
      (:commit when-matched)
      (:do none)
      (:while (hold-axis-state plane top))
      (:exit (set-axis-state plane base))
    )
  )
  (interaction
    tap-hold-case-f
    (:participants f)
    (:observe any-position)
    (:anchor f)
    (:arbitration (priority hold-timeout hold-after-foreign-release tap))
    (case
      hold-timeout
      (:match (deadline 200 :after (down f) :while-down f))
      (:commit when-matched)
      (:do none)
      (:effect-start on-commit)
      (:while (hold-axis-state case shifted))
    )
    (case
      hold-after-foreign-release
      (:match
        (sequence
          (down f)
          (capture foreign (down (other-than f)))
          (up (captured foreign))
        )
      )
      (:commit when-matched)
      (:do none)
      (:effect-start on-commit)
      (:while (hold-axis-state case shifted))
    )
    (case
      tap
      (:match (and (sequence (down f) (up f)) (duration f :less-than 200)))
      (:commit when-matched)
      (:do (named-key f))
    )
  )

  (binding hotkey-19 (named-key f19))
  (binding hotkey-21 (named-key f21))
  (interaction
    hold-case-left-shift
    (:participants case-left-shift)
    (case
      held
      (:match (down case-left-shift))
      (:commit when-matched)
      (:do none)
      (:while (hold-axis-state case shifted))
      (:exit (set-axis-state case plain))
    )
  )
  (interaction
    hold-case-right-shift
    (:participants case-right-shift)
    (case
      held
      (:match (down case-right-shift))
      (:commit when-matched)
      (:do none)
      (:while (hold-axis-state case shifted))
      (:exit (set-axis-state case plain))
    )
  )
